root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.csproj]
indent_size = 2

[*.cs]
charset = utf-8-bom

# .Net Compiler rule
dotnet_analyzer_diagnostic.category-Style.severity = warning
dotnet_diagnostic.IDE0003.severity = silent
dotnet_diagnostic.IDE0007.severity = silent
dotnet_diagnostic.IDE0008.severity = silent
dotnet_diagnostic.IDE0009.severity = warning
dotnet_diagnostic.IDE0022.severity = silent
dotnet_diagnostic.IDE0160.severity = silent
dotnet_diagnostic.CS1591.severity = silent
dotnet_diagnostic.IDE0001.severity = silent # for local
dotnet_diagnostic.IDE0002.severity = silent # for local
dotnet_diagnostic.IDE0065.severity = silent # for local
dotnet_diagnostic.IDE0130.severity = silent # for local
dotnet_diagnostic.CA1054.severity = silent # for local
dotnet_diagnostic.CA1062.severity = silent # for local
dotnet_diagnostic.CA1707.severity = silent # for local
dotnet_diagnostic.CA1711.severity = silent # for local
dotnet_diagnostic.CA1716.severity = silent # for local
dotnet_diagnostic.CA1724.severity = silent # for local
dotnet_diagnostic.CA1810.severity = silent # for local
dotnet_diagnostic.CA1822.severity = silent # for local
dotnet_diagnostic.CA1852.severity = silent # for local

[*.{ini,toml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.sln]
end_of_line = crlf
indent_style = tab

[*.ts]
indent_size = 2

[*.{yaml,yml}]
indent_size = 2

[nuget.config]
indent_size = 2
